# Copy to .env for local dev, and set the same values in
# Vercel → Project → Settings → Environment Variables.

# --- Client bundle (inlined at BUILD time by Vite; must be present when building) ---
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# --- Server / SSR (read from process.env at RUNTIME by the serverless function) ---
# Same values as above, without the VITE_ prefix. Required by
# src/integrations/supabase/auth-middleware.ts and client.ts's SSR fallback.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-ref>"

# Service role / secret key — bypasses RLS. Server-only, never expose to the client.
# Required by src/integrations/supabase/client.server.ts for admin operations.
# Get it from Supabase → Project Settings → API keys.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Lovable AI gateway key. Only issued inside Lovable Cloud.
# Without it the app still runs, but natural-language search and AI-assisted
# listing creation throw "Missing LOVABLE_API_KEY".
LOVABLE_API_KEY=""
