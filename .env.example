# Copy to .env for local dev, and set the same values in
# Vercel → Project → Settings → Environment Variables.

# --- Client bundle (inlined at BUILD time by Vite; must be present when building) ---
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# --- Server / SSR (read from process.env at RUNTIME by the serverless function) ---
# Same values as above, without the VITE_ prefix. Required by
# src/integrations/supabase/auth-middleware.ts and client.ts's SSR fallback.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-ref>"

# Service role / secret key — bypasses RLS. Server-only, never expose to the client.
# Required by src/integrations/supabase/client.server.ts for admin operations.
# Get it from Supabase → Project Settings → API keys.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- AI features (natural-language search, listing autofill from photos) ---
# Both require a signed-in user and are rate limited per user.
# Provider is picked in this order (src/lib/ai.server.ts):
#   1. LOVABLE_API_KEY → Lovable AI gateway (only issued inside Lovable Cloud).
#   2. AI_API_URL + AI_API_KEY (+ AI_MODEL) → any OpenAI-compatible
#      chat-completions endpoint. Examples:
#        OpenAI: AI_API_URL="https://api.openai.com/v1"  AI_MODEL="gpt-4o-mini"
#        Gemini: AI_API_URL="https://generativelanguage.googleapis.com/v1beta/openai"  AI_MODEL="gemini-2.5-flash"
#      The base URL or the full .../chat/completions URL both work. The model
#      must support JSON mode, and image input for listing autofill.
#   3. None set → the features return "AI features aren't configured".
LOVABLE_API_KEY=""
AI_API_URL=""
AI_API_KEY=""
AI_MODEL=""

# --- Rate limiting (optional, recommended in production) ---
# Upstash Redis REST credentials (Upstash console → your database → REST API).
# Used for per-user/IP limits on AI, messages, tour requests and /api/public/geocode.
# Without them limits are kept in memory per serverless instance (weaker).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Email notifications (Resend) ---
# New message, tour requested/confirmed/declined/cancelled, saved-search digests.
# Leave empty to disable (sends become logged no-ops). EMAIL_FROM's domain must
# be verified in Resend, e.g. "Nestly <hello@mail.yourdomain.in>".
# Links in emails use PUBLIC_SITE_URL (see "Monitoring & SEO" below).
RESEND_API_KEY=""
EMAIL_FROM=""

# --- Scheduled jobs ---
# Shared secret for /api/public/hooks/saved-search-alerts. Vercel Cron sends
# "Authorization: Bearer $CRON_SECRET" automatically when this variable is set
# in the Vercel project (schedule lives in vercel.json → "crons"). The job
# refuses to run if it is unset. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Monitoring & SEO ---
# Canonical public origin (no trailing slash). Used for canonical tags, OG image
# URLs, JSON-LD and sitemap.xml. VITE_ is read at build time; PUBLIC_SITE_URL is
# the server-runtime fallback. Default: https://nestly-homes.vercel.app
VITE_SITE_URL="https://nestly-homes.vercel.app"
PUBLIC_SITE_URL="https://nestly-homes.vercel.app"

# Sentry (browser error monitoring). Leave empty to disable — the SDK is then
# never downloaded. Get the DSN from Sentry → Project Settings → Client Keys.
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="production"
# Fraction of page loads to trace for performance (0 disables tracing).
VITE_SENTRY_TRACES_SAMPLE_RATE="0"
